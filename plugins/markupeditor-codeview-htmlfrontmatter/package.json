  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "jsdom": "^27.0.1",
    "markupeditor": "^0.9.28",
    "rollup": "^4.31.0",
    "rollup-plugin-import-css": "^4.0.1",
    "vitest": "^3.2.4"
